<Window x:Class="BimTools.SpxExporter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:BimTools.SpxExporter.Infrastructure"
        Title="BIM TOOLS - SPX Batch Exporter"
        Width="1120" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <infra:InvertBooleanConverter x:Key="InvertBool" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#344054" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2A37" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#175CD3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#175CD3" />
            <Setter Property="Padding" Value="26,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#475467" />
                <ComboBox Width="190" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" />
            </StackPanel>
        <StackPanel Grid.Column="0">
            <TextBlock Text="SPX Batch Exporter" FontSize="20" FontWeight="SemiBold" Foreground="#1F2A37" />
            <TextBlock Text="Batch-export Revit 2024 models directly to SYNCHRO 4D (.spx), unattended, beside each original file."
                       Foreground="#667085" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#D0D5DD">

            <!-- Models -->
            <TabItem Header="Models">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Auto-export folder tree..." Command="{Binding AutoFolderCommand}" FontWeight="SemiBold"
                                Background="#EFF8FF" BorderBrush="#175CD3"
                                ToolTip="Pick a root folder: every Revit model in it and its sub-folders is queued and exported beside its original file, fully automatically." />
                        <Button Content="Add files..." Command="{Binding AddFilesCommand}" />
                        <Button Content="Add folder..." Command="{Binding AddFolderCommand}" />
                        <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="Add active model" Command="{Binding AddActiveCommand}" />
                        <Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" CommandParameter="{Binding SelectedItems, ElementName=ModelGrid}" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" />
                        <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                        <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
                        <Button Content="Move up" Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=ModelGrid}" />
                        <Button Content="Move down" Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=ModelGrid}" />
                        <Button Content="Sort by path" Command="{Binding SortCommand}" />
                        <Button Content="Import list..." Command="{Binding ImportListCommand}" />
                        <Button Content="Save list..." Command="{Binding ExportListCommand}" />
                        <Button Content="Show in folder" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding SelectedItem, ElementName=ModelGrid}" />
                        <Button Content="Pre-flight check" Command="{Binding PreflightCommand}" />
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#475467" />
                        <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <DataGrid x:Name="ModelGrid" Grid.Row="1" ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderBrush="#D0D5DD" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Export" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Model" Binding="{Binding FileName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Revit" Binding="{Binding RevitVersion}" IsReadOnly="True" Width="60" />
                            <DataGridCheckBoxColumn Header="Workshared" Binding="{Binding IsWorkshared, Mode=OneWay}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" IsReadOnly="True" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding SelectedCountText}" Foreground="#475467" />
                </Grid>
            </TabItem>

            <!-- Output -->
            <TabItem Header="Output">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Export method" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding EngineChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.Engine}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="SPX is a proprietary SYNCHRO format, so the direct SPX method runs the SYNCHRO 4D Revit exporter that is installed on this computer and answers its prompts automatically. The other methods write CSV reports or IFC." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.OutputToSourceFolder, Converter={StaticResource InvertBool}}" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                        </Grid>
                        <CheckBox Content="Save beside each original Revit file (recommended)" IsChecked="{Binding Settings.OutputToSourceFolder}" />
                        <CheckBox Content="Keep the source sub-folder structure (when a folder was added)" IsChecked="{Binding Settings.PreserveFolderStructure}" />
                        <CheckBox Content="Create a dated sub-folder (yyyy-MM-dd)" IsChecked="{Binding Settings.CreateDateSubfolder}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Coordinates and view" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Coordinate system" Margin="0,6,0,4" />
                        <ComboBox ItemsSource="{Binding CoordinateChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.CoordinateSystem}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Selected automatically in the SYNCHRO exporter's dialog (it looks for a shared / project coordinate option). If your exporter words it differently, add an exact rule on the SYNCHRO (SPX) tab." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="View projection" />
                        <ComboBox ItemsSource="{Binding ProjectionChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.ViewProjection}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Picks (or creates) an orthographic or perspective 3D view in every model. The view is made active before the SYNCHRO exporter runs. For perspective, make sure the camera covers the model." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="File name template" />
                        <TextBox Text="{Binding Settings.FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Tokens: {ModelName} {Date} {Time} {DateTime} {RevitVersion} {SourceVersion} {ViewName} {User} {Index}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="If the output file already exists" />
                        <ComboBox ItemsSource="{Binding OverwriteChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.OverwritePolicy}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Model opening -->
            <TabItem Header="Model opening">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Workshared models" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DetachChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.DetachMode}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Detaching opens a private copy, so the central model is never touched and no local file is created." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Worksets to open" />
                        <ComboBox ItemsSource="{Binding WorksetChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.WorksetMode}" />
                        <StackPanel Visibility="{Binding IsWorksetFilterVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Only open worksets matching (separate with ;  wildcards * and ? allowed)" />
                            <TextBox Text="{Binding Settings.WorksetIncludePatterns, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Never open worksets matching" />
                            <TextBox Text="{Binding Settings.WorksetExcludePatterns, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="3D view used for the export" />
                        <ComboBox ItemsSource="{Binding ViewChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.ViewMode}" />
                        <StackPanel Visibility="{Binding IsViewNameVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="3D view name" />
                            <TextBox Text="{Binding Settings.ViewName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="Create a temporary 3D view when no suitable view exists" IsChecked="{Binding Settings.FallbackToTemporaryView}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Skip files whose name matches when adding a folder (separate with ;  wildcards allowed)" />
                        <TextBox Text="{Binding Settings.ExcludeFilePatterns, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="The default skips *_detached* copies, which clash with their central model (Revit cannot open a local copy and its central together)." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Behaviour" />
                        <CheckBox Content="Audit models while opening (slower)" IsChecked="{Binding Settings.AuditOnOpen}" />
                        <CheckBox Content="Automatically dismiss Revit warnings and dialogs (IFC / data exports only)" IsChecked="{Binding Settings.SuppressDialogs}" />
                        <CheckBox Content="Continue with the next model when one fails" IsChecked="{Binding Settings.ContinueOnError}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Automatic retries per model (0-5)" />
                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding Settings.RetryCount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- IFC -->
            <TabItem Header="IFC" Visibility="{Binding IsIfcEngine, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="IFC version" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding IfcChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.IfcVersion}" />
                        <CheckBox Content="Export base quantities" IsChecked="{Binding Settings.IfcExportBaseQuantities}" Margin="0,12,0,5" />
                        <CheckBox Content="Split walls and columns by level" IsChecked="{Binding Settings.IfcSplitWalls}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SYNCHRO -->
            <TabItem Header="SYNCHRO (SPX)" Visibility="{Binding IsSynchroEngine, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Foreground="#344054"
                                   Text="The batch opens each model, activates its 3D view and launches the installed SYNCHRO exporter automatically (it is detected for you; use the buttons below only if detection fails). Complete the exporter's own dialog; the batch moves on when the new .spx file appears, or when you press 'Continue to next model'." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="SYNCHRO exporter command id" />
                        <TextBox Text="{Binding Settings.SynchroCommandId, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Auto-detect exporter" Command="{Binding AutoDetectCommand}" FontWeight="SemiBold" />
                            <Button Content="Scan journals" Command="{Binding ScanJournalsCommand}" />
                            <Button Content="Test command id" Command="{Binding TestCommandIdCommand}" />
                        </WrapPanel>
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding JournalCommands}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedJournalCommand}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="How to find the id: click the SYNCHRO export button once in Revit, then press 'Scan journals'. Commands recorded in your Revit journals are listed, SYNCHRO-looking ones first." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Folder watched for new .spx files (blank = output folder)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.SynchroWatchFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowseWatchCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout per model (minutes)" />
                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding Settings.SynchroTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Unattended mode" />
                        <CheckBox Content="Answer the exporter's dialogs automatically (save path, select folder, confirmations)" IsChecked="{Binding Settings.AutoAnswerDialogs}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="When the exporter opens a Save or folder dialog, the path of the SPX file beside the original Revit model is filled in and the dialog is confirmed. Every dialog that appears is written to the log with its control names, so the rules below can be tuned." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Buttons to press, in priority order (separate with ;)" />
                        <TextBox Text="{Binding Settings.AutoClickButtons, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Field rules for the exporter's dialog (optional)" />
                        <TextBox Text="{Binding Settings.DialogFieldOverrides, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Format: Label=Value;Label=true;Radio or check box name. Example: Coordinates=Shared;Include properties=true;Shared Coordinates. Labels must match the control names shown in the log." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- View preparation -->
            <TabItem Header="View preparation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Foreground="#344054"
                                   Text="Applies to the 3D view that is activated for the SYNCHRO export. Temporary views are always prepared; existing views only when enabled below. Nothing is saved to your models." />
                        <CheckBox Content="Also prepare existing 3D views (in-memory only; never applied to the model you have open)" IsChecked="{Binding Settings.PrepareExistingViews}" Margin="0,10,0,5" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Detail level" />
                        <ComboBox ItemsSource="{Binding DetailChoices}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                  SelectedValue="{Binding Settings.ViewDetailLevel}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Hide categories" />
                        <CheckBox Content="Rooms" IsChecked="{Binding Settings.ViewHideRooms}" />
                        <CheckBox Content="Grids and levels" IsChecked="{Binding Settings.ViewHideGridsAndLevels}" />
                        <CheckBox Content="Revit links" IsChecked="{Binding Settings.ViewHideLinks}" />
                        <CheckBox Content="View markers (cameras, section and callout tags)" IsChecked="{Binding Settings.ViewHideViewMarkers}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Other categories by name (separate with ;  wildcards allowed)" />
                        <TextBox Text="{Binding Settings.ViewHideCategoryNames, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Hide worksets in the view by name (separate with ;  wildcards allowed)" />
                        <TextBox Text="{Binding Settings.ViewHideWorksetPatterns, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Phasing (useful for 4D)" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Phase (blank = leave as is)" />
                        <TextBox Text="{Binding Settings.ViewPhaseName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Phase filter, for example Show All (blank = leave as is)" />
                        <TextBox Text="{Binding Settings.ViewPhaseFilterName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Element data -->
            <TabItem Header="Element data">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Foreground="#344054"
                                   Text="Writes one CSV row per model element: element id, unique id, category, family, type, level, phase created/demolished, workset and the parameters you list. Use it to link a schedule or WBS to the 4D model. Choose 'Element data CSV' as the export method, or tick the box below to write it next to every SPX export." />
                        <CheckBox Content="Also write an element data CSV next to every export" IsChecked="{Binding Settings.AlsoExportElementData}" Margin="0,10,0,5" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Parameters to include (separate with ;  - names as shown in Revit)" />
                        <TextBox Text="{Binding Settings.DataParameterNames, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Fall back to type parameters when the instance has no value" IsChecked="{Binding Settings.DataIncludeTypeParameters}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Only these categories (blank = all model categories; wildcards allowed)" />
                        <TextBox Text="{Binding Settings.DataCategoryFilter, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Model inspection report" />
                        <CheckBox Content="Deep scan (warnings, rooms, element count, CAD instances) - slower" IsChecked="{Binding Settings.InspectionDeepScan}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Post-processing -->
            <TabItem Header="Post-processing" Visibility="{Binding IsConverterAvailable, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <CheckBox Content="Run a converter on each exported IFC file" IsChecked="{Binding Settings.PostProcessEnabled}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Use this with any command-line tool that converts the exported IFC file. The batch starts it once per exported file and waits for it to finish." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Converter executable" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.PostProcessExecutable, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowseExecutableCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments" />
                        <TextBox Text="{Binding Settings.PostProcessArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Tokens: {input} {output} {outputDir} {name}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Converted file extension" />
                        <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Settings.PostProcessOutputExtension, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout per file (minutes)" />
                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding Settings.PostProcessTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="Delete the intermediate IFC file after a successful conversion" IsChecked="{Binding Settings.DeleteIntermediateFiles}" Margin="0,12,0,5" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Delivery -->
            <TabItem Header="Reporting and delivery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Reports" Margin="0,0,0,2" />
                        <CheckBox Content="Write a CSV report (status, duration and output of every model)" IsChecked="{Binding Settings.WriteCsvReport}" />
                        <CheckBox Content="Write an HTML report for sharing" IsChecked="{Binding Settings.WriteHtmlReport}" />
                        <CheckBox Content="Open the output folder when the batch finishes" IsChecked="{Binding Settings.OpenOutputFolderWhenDone}" />
                        <CheckBox Content="Show a summary dialog when the batch finishes" IsChecked="{Binding Settings.ShowSummaryDialog}" />
                        <CheckBox Content="Play a sound when the batch finishes" IsChecked="{Binding Settings.PlaySoundWhenDone}" />
                        <TextBlock Style="{StaticResource Hint}" Text="A detailed log file is always written to %AppData%\BimTools\SpxExporter\Logs." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Delivery" />
                        <CheckBox Content="Zip all outputs into one archive" IsChecked="{Binding Settings.CreateZipArchive}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Also copy every output to this folder (for example a network share)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.SecondaryCopyFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowseCopyFolderCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Run a program when the batch finishes (optional)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.RunAfterBatchExecutable, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Command="{Binding BrowsePostBatchCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments" />
                        <TextBox Text="{Binding Settings.RunAfterBatchArguments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Tokens: {reportPath} {outputDir} {logPath}" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Schedule" />
                        <CheckBox Content="Wait and start at a set time (for example overnight)" IsChecked="{Binding Settings.ScheduleEnabled}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Start time (HH:mm, 24-hour)" />
                        <TextBox Width="100" HorizontalAlignment="Left" Text="{Binding Settings.ScheduledStart, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Revit must stay open and the computer awake. If the time has already passed today, the batch starts tomorrow." />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Presets" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Import preset..." Command="{Binding ImportSettingsCommand}" />
                            <Button Content="Save preset..." Command="{Binding ExportSettingsCommand}" />
                            <Button Content="Reset to defaults" Command="{Binding ResetSettingsCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Presets saved in the presets folder appear in the Preset list at the top of the window. Share a preset file so every project exports to the same standard." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#475467" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Padding="22,8" />
                <Button Style="{StaticResource PrimaryButton}" Content="Start export" Command="{Binding StartCommand}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
